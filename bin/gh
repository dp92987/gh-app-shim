#!/usr/bin/env bash
#
# gh-app-shim — a transparent replacement for the `gh` CLI.
#
#   * When invoked inside an agent session — Claude Code (CLAUDECODE is set) or
#     Codex (GH_SHIM_CODEX is set; see install.sh) — it authenticates as a
#     GitHub App installation, so PRs, comments and reviews appear as the app
#     bot, not as a human user.
#   * When invoked by a human in a normal shell, it passes straight through
#     to the real `gh` and uses whatever auth the human already has.
#
# The same script also serves two explicit commands, installed as symlinks to
# it, that always act as a bot whoever the caller is:
#
#   * gh-claude          — the primary App, the one plain `gh` uses in a
#                          Claude Code session.
#   * gh-claude-reviewer — a second App with its own key, so a review posted
#                          by it is clearly a different bot from the author.
#
# Configuration lives outside this repo (no secrets in git):
#   ~/.config/gh-app-shim/config.env   (override with GH_APP_SHIM_CONFIG)
#
set -euo pipefail

CONFIG_FILE="${GH_APP_SHIM_CONFIG:-$HOME/.config/gh-app-shim/config.env}"
# shellcheck disable=SC1090
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

# --- locate the real gh (never this shim) -----------------------------------
resolve_real_gh() {
  if [[ -n "${REAL_GH:-}" && -x "${REAL_GH:-}" ]]; then
    printf '%s' "$REAL_GH"
    return 0
  fi
  local me cand resolved
  me=$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")
  while IFS= read -r cand; do
    [[ -z "$cand" ]] && continue
    resolved=$(readlink -f "$cand" 2>/dev/null || printf '%s' "$cand")
    [[ "$resolved" == "$me" ]] && continue
    printf '%s' "$cand"
    return 0
  done < <(type -ap gh 2>/dev/null)
  return 1
}

real_gh=$(resolve_real_gh) || {
  echo "gh-app-shim: could not locate the real gh binary." >&2
  echo "             set REAL_GH in $CONFIG_FILE, or install gh." >&2
  exit 127
}

# --- identity: chosen by the name we were invoked as ------------------------
# gh                 — the original behavior: the bot inside an agent session,
#                      your own auth in a human shell or a passthrough repo.
# gh-claude          — always the primary App bot (APP_ID / INSTALLATION_ID).
# gh-claude-reviewer — always the second App bot (REVIEWER_* in the config).
# An explicit command name is an explicit choice of identity, so the session
# marker and the passthrough lists below are checked for `gh` only — otherwise
# `gh-claude-reviewer` would silently act as someone else.
case "$(basename -- "$0")" in
  gh-claude-reviewer) profile=reviewer ;;
  gh-claude)          profile=claude ;;
  *)                  profile=default ;;
esac

# --- human shell → transparent pass-through ---------------------------------
# CLAUDECODE is set by Claude Code; GH_SHIM_CODEX is injected into Codex
# sessions via ~/.codex/config.toml's shell_environment_policy (Codex has no
# built-in marker of its own — install.sh wires this up). With neither set we
# are in a plain human shell, so pass straight through to the real gh.
if [[ "$profile" == default && -z "${CLAUDECODE:-}" && -z "${GH_SHIM_CODEX:-}" ]]; then
  exec "$real_gh" "$@"
fi

# --- passthrough: which orgs/repos should act as YOU, not the bot -----------
# By default a Claude Code session acts as the GitHub App bot. For repos/orgs
# listed below, the shim falls through to the real gh with your own auth — so
# Claude acts as you there, just like a normal terminal would. Access control
# (which repos the bot can touch at all) is left to the App's own GitHub
# permissions; this setting only chooses which credential to use.
#
# Optional config (space-separated, case-insensitive):
#   PASSTHROUGH_ORGS   — match the repo owner.
#   PASSTHROUGH_REPOS  — match the full "owner/repo".
# With none set, every Claude Code invocation acts as the bot (original
# behavior). Commands with no detectable repo (e.g. `gh api user`) act as the
# bot. The target repo is taken from an explicit -R/--repo flag, else the
# current directory's git origin/upstream remote.

# Normalize a repo spec — "owner/repo", a GitHub URL, an scp-style git remote,
# or "host/owner/repo" — to "owner/repo". Prints nothing and returns 1 if it
# can't extract both an owner and a repo.
normalize_repo() {
  local spec="${1%.git}" owner repo rest
  if [[ "$spec" == *@*:* ]]; then        # git@github.com:owner/repo
    spec="${spec##*:}"
  elif [[ "$spec" == *://* ]]; then      # https://github.com/owner/repo
    spec="${spec#*://}"; spec="${spec#*/}"
  fi
  spec="${spec%/}"
  repo="${spec##*/}"
  rest="${spec%/*}"
  owner="${rest##*/}"
  [[ -n "$owner" && -n "$repo" && "$owner" != "$repo" ]] || return 1
  printf '%s/%s' "$owner" "$repo"
}

# Pull an explicit -R/--repo target out of the gh argument list, if present.
detect_repo_from_args() {
  local want_value="" a
  for a in "$@"; do
    if [[ -n "$want_value" ]]; then
      normalize_repo "$a"; return
    fi
    case "$a" in
      -R|--repo)  want_value=1 ;;
      --repo=*)   normalize_repo "${a#--repo=}"; return ;;
      -R?*)       normalize_repo "${a#-R}"; return ;;
    esac
  done
  return 1
}

# Fall back to the current directory's git remote (origin, then upstream).
detect_repo_from_git() {
  local url
  url=$(git remote get-url origin 2>/dev/null) \
    || url=$(git remote get-url upstream 2>/dev/null) \
    || return 1
  normalize_repo "$url"
}

# Case-insensitive membership test: in_list <needle> <space-separated list>.
in_list() {
  local needle="${1,,}" item
  for item in $2; do
    [[ "${item,,}" == "$needle" ]] && return 0
  done
  return 1
}

# True if this invocation targets a repo/org configured for passthrough.
wants_passthrough() {
  [[ -n "${PASSTHROUGH_ORGS:-}${PASSTHROUGH_REPOS:-}" ]] || return 1

  local repo owner
  repo=$(detect_repo_from_args "$@") || repo=$(detect_repo_from_git) || repo=""
  # No repo detected (e.g. `gh api user`) → act as the bot, not passthrough.
  [[ -n "$repo" ]] || return 1
  owner="${repo%%/*}"

  in_list "$repo" "${PASSTHROUGH_REPOS:-}" || in_list "$owner" "${PASSTHROUGH_ORGS:-}"
}

# Configured passthrough repo → behave like a normal terminal (your own auth).
if [[ "$profile" == default ]] && wants_passthrough "$@"; then
  exec "$real_gh" "$@"
fi

# --- authenticate as the GitHub App bot ------------------------------------
# The reviewer is a different App, so it needs its own id, installation and
# key. Its token is cached separately — one cache file per App, or the two
# would overwrite each other's token.
token_suffix=""
if [[ "$profile" == reviewer ]]; then
  : "${REVIEWER_APP_ID:?gh-app-shim: REVIEWER_APP_ID not set in $CONFIG_FILE}"
  : "${REVIEWER_INSTALLATION_ID:?gh-app-shim: REVIEWER_INSTALLATION_ID not set in $CONFIG_FILE}"
  : "${REVIEWER_KEY_PATH:?gh-app-shim: REVIEWER_KEY_PATH not set in $CONFIG_FILE}"
  APP_ID="$REVIEWER_APP_ID"
  INSTALLATION_ID="$REVIEWER_INSTALLATION_ID"
  KEY_PATH="$REVIEWER_KEY_PATH"
  token_suffix="-reviewer"
else
  : "${APP_ID:?gh-app-shim: APP_ID not set in $CONFIG_FILE}"
  : "${INSTALLATION_ID:?gh-app-shim: INSTALLATION_ID not set in $CONFIG_FILE}"
  : "${KEY_PATH:?gh-app-shim: KEY_PATH not set in $CONFIG_FILE}"
fi

TOKEN_FILE="${TOKEN_CACHE:-${XDG_RUNTIME_DIR:-/tmp}/gh-app-shim-token}${token_suffix}"
EXPIRES_FILE="${TOKEN_FILE}.expires"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

mint_token() {
  if [[ ! -r "$KEY_PATH" ]]; then
    echo "gh-app-shim: cannot read private key at $KEY_PATH" >&2
    exit 1
  fi
  local now iat exp header payload signature jwt response token
  now=$(date +%s)
  iat=$((now - 60))
  exp=$((now + 540))   # GitHub rejects App JWTs with >10 min lifetime
  header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  payload=$(printf '{"iss":"%s","iat":%d,"exp":%d}' "$APP_ID" "$iat" "$exp" | b64url)
  signature=$(printf '%s.%s' "$header" "$payload" \
    | openssl dgst -sha256 -sign "$KEY_PATH" -binary \
    | b64url)
  jwt="${header}.${payload}.${signature}"

  response=$(curl -fsS -X POST \
    -H "Authorization: Bearer ${jwt}" \
    -H "Accept: application/vnd.github+json" \
    "https://api.github.com/app/installations/${INSTALLATION_ID}/access_tokens") || {
      echo "gh-app-shim: request for installation token failed" >&2
      exit 1
    }

  token=$(printf '%s' "$response" | grep -o '"token"[ ]*:[ ]*"[^"]*"' | head -1 | cut -d'"' -f4)
  if [[ -z "$token" ]]; then
    echo "gh-app-shim: failed to obtain installation token" >&2
    printf '%s\n' "$response" >&2
    exit 1
  fi

  ( umask 077; printf '%s' "$token" > "$TOKEN_FILE" )
  # Installation tokens live ~1h; cache for 55m, the shim adds a 60s buffer.
  printf '%s' "$(($(date +%s) + 3300))" > "$EXPIRES_FILE"
}

need_refresh=true
if [[ -f "$TOKEN_FILE" && -f "$EXPIRES_FILE" ]]; then
  if (( $(date +%s) < $(cat "$EXPIRES_FILE") - 60 )); then
    need_refresh=false
  fi
fi
$need_refresh && mint_token

# Guard: never let gh silently fall back to the human's keyring auth.
# If GH_TOKEN reaches gh empty (missing/empty cache file), gh uses the
# personal token from hosts.yml and acts as the human — the precise failure
# this shim exists to prevent. An installation token is always "ghs_…"; bail
# loudly on anything else instead of impersonating the user.
app_token=$(cat "$TOKEN_FILE" 2>/dev/null || true)
if [[ "$app_token" != ghs_* ]]; then
  echo "gh-app-shim: no valid installation token available; refusing to run" >&2
  echo "             as your personal GitHub account. Try again (the shim will" >&2
  echo "             re-mint), or check APP_ID/INSTALLATION_ID/KEY_PATH in"     >&2
  echo "             $CONFIG_FILE." >&2
  exit 1
fi

# Override GITHUB_TOKEN too, so a stray personal token in the environment
# can't shadow the installation token.
exec env GH_TOKEN="$app_token" GITHUB_TOKEN="$app_token" "$real_gh" "$@"
